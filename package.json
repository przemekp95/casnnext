{
  "name": "casn",
  "version": "0.3.2",
  "private": true,
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npm run build:lib && next build",
    "build:lib": "tsc lib/db.server.ts --outDir . --target ES2022 --module commonjs --moduleResolution node --esModuleInterop --allowSyntheticDefaultImports --skipLibCheck",
    "prebuild": "bash scripts/check-posts.sh",
    "postbuild": "node scripts/prepare-tmp.js",
    "start": "node server.cjs",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx,.cjs --max-warnings 0",
    "lint:fix": "eslint . --ext .ts,.tsx,.js,.jsx,.cjs --fix --max-warnings 0",
    "quality:policy": "bash scripts/ci/quality-debt-policy.sh",
    "runtime:policy": "bash scripts/ci/runtime-source-policy.sh . all",
    "runtime:policy:test": "bash scripts/ci/runtime-source-policy-test.sh",
    "type-check": "tsc --noEmit -p tsconfig.ci.json",
    "test": "jest",
    "test:ci": "jest --runInBand",
    "test:unit": "jest",
    "test:integration:hydration": "jest --testPathPatterns=HydrationAndDataIntegration --runInBand",
    "test:integration:live": "RUN_LIVE_TESTS=1 jest --runInBand --testPathPatterns='\\.live\\.test\\.'",
    "test:live": "RUN_LIVE_TESTS=1 jest --runInBand --testPathPatterns='\\.live\\.test\\.'",
    "test:e2e": "cypress run --headless",
    "test:e2e:hydration": "cypress run --spec 'cypress/e2e/hydration.cy.ts'",
    "check:posts": "bash scripts/check-posts.sh",
    "check:cms-mdx-media": "bash scripts/ci/check-cms-mdx-media-paths.sh",
    "audit:policy": "bash scripts/ci/security-audit-policy.sh",
    "compose:policy": "bash scripts/ci/compose-policy.sh",
    "deploy:policy": "bash scripts/ci/deployment-artifact-policy.sh",
    "directus:smoke": "bash scripts/ci/directus-smoke.sh",
    "snapshot:test": "jest --runInBand test/unit/snapshot test/integration/snapshot",
    "snapshot:smoke": "bash scripts/ci/snapshot-roundtrip.sh",
    "db:seed": "echo 'Seeding handled by migrations - data included in InitialSetup migration'",
    "migration:run": "tsx scripts/run-migrations.ts",
    "migration:create": "tsx node_modules/.bin/typeorm migration:create",
    "migration:revert": "tsx node_modules/.bin/typeorm migration:revert -d lib/db.datasource.ts"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.0",
    "@mdx-js/react": "^3.1.0",
    "@next/mdx": "^16.1.6",
    "@popperjs/core": "^2.11.8",
    "bcrypt": "^6.0.0",
    "gray-matter": "^4.0.3",
    "mdx": "^0.3.1",
    "mysql2": "^3.18.2",
    "next": "16.3.3",
    "next-auth": "4.24.15",
    "next-mdx-remote": "^6.0.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.4",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "typeorm": "0.3.31",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@exodus/bytes": "^1.14.1",
    "@npmcli/fs": "^5.0.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.3.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "csv-parse": "^6.1.0",
    "cypress": "15.21.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.3",
    "jest": "30.4.2",
    "jest-environment-jsdom": "30.4.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.4",
    "typescript": "^5.6.0",
    "wait-on": "^9.0.4"
  },
  "overrides": {
    "axios": "^1.13.5",
    "diff": "^4.0.4",
    "lodash": "^4.17.23",
    "trim-newlines": "3.0.1",
    "nodemailer": "^7.0.7",
    "qs": ">=6.15.0",
    "rimraf": "^4.4.1",
    "glob": "13.0.6",
    "@npmcli/move-file": "npm:@npmcli/fs@^5.0.0",
    "html-encoding-sniffer": "^6.0.0",
    "jsdom": "^27.4.0",
    "minimatch": "^10.2.4",
    "tar": "^7.5.9",
    "@eslint/eslintrc": {
      "minimatch": "3.1.4"
    },
    "babel-plugin-istanbul": "8.0.0",
    "test-exclude": {
      ".": "8.0.0"
    },
    "eslint-config-next": {
      "eslint-plugin-react-hooks": "7.0.1"
    },
    "gray-matter": {
      "js-yaml": "3.15.1"
    }
  },
  "allowScripts": {
    "bcrypt@6.0.0": true,
    "cypress@15.21.1": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "unrs-resolver@1.12.2": true
  }
}
