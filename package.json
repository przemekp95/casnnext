{
  "name": "casn",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "prebuild": "bash scripts/check-posts.sh",
    "postbuild": "node scripts/prepare-tmp.js",
    "start": "next start -p $PORT",
    "start:standalone": "node .next/standalone/server.js",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "lint:fix": "eslint . --ext .ts,.tsx,.js,.jsx --fix",
    "type-check": "tsc --noEmit -p tsconfig.ci.json",
    "test": "jest",
    "test:ci": "jest --runInBand",
    "test:unit": "jest",
    "test:e2e": "cypress run --headless",
    "check:posts": "bash scripts/check-posts.sh",
    "db:seed": "echo 'Seeding handled by migrations - data included in InitialSetup migration'",
    "migration:run": "echo 'Skipping migrations - database already initialized'",
    "migration:create": "tsx node_modules/.bin/typeorm migration:create",
    "migration:revert": "tsx node_modules/.bin/typeorm migration:revert -d lib/db.ts",
    "logs:server": "tail -f tmp/runtime.log",
    "logs:client": "tail -f tmp/client.log",
    "deploy": "bash scripts/deploy.sh"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@capacitor/cli": "^7.4.3",
    "@capacitor/core": "^7.4.3",
    "@mdi/font": "^7.4.47",
    "@mdx-js/loader": "^3.1.0",
    "@mdx-js/react": "^3.1.0",
    "@next/mdx": "^15.5.0",
    "@popperjs/core": "^2.11.8",
    "@prisma/adapter-mariadb": "^6.9.0",
    "@prisma/client": "^6.9.0",
    "bcrypt": "^6.0.0",
    "bootstrap": "^5.3.7",
    "gray-matter": "^4.0.3",
    "mdx": "^0.3.1",
    "mysql2": "^3.15.3",
    "next": "^16.1.1",
    "next-auth": "4.24.12",
    "next-mdx-remote": "^5.0.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "reflect-metadata": "^0.2.2",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "typeorm": "^0.3.28",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/ios": "^7.4.3",
    "@eslint/eslintrc": "^3",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/next": "^9.0.0",
    "@types/node": "^22.19.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "csv-parse": "^6.1.0",
    "cypress": "^15.8.0",
    "eslint": "^9",
    "eslint-config-next": "15.4.6",
    "jest": "^30.1.1",
    "jest-environment-jsdom": "^30.1.1",
    "lighthouse": "^12.8.1",
    "prisma": "^6.9.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.4",
    "typescript": "^5.6.0",
    "wait-on": "^8.0.4"
  },
  "overrides": {
    "trim-newlines": "3.0.1",
    "nodemailer": "^7.0.7",
    "qs": ">=6.14.1"
  }
}