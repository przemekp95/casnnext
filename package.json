{
  "name": "casn",
  "version": "0.3.2",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npm run build:lib && next build",
    "build:lib": "tsc lib/db.server.ts --outDir . --target ES2022 --module commonjs --moduleResolution node --esModuleInterop --allowSyntheticDefaultImports --skipLibCheck",
    "prebuild": "bash scripts/check-posts.sh",
    "postbuild": "node scripts/prepare-tmp.js",
    "start": "next start -p $PORT",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx --ignore-pattern 'lib/' --ignore-pattern 'migrations/'",
    "lint:fix": "eslint . --ext .ts,.tsx,.js,.jsx --fix --ignore-pattern 'lib/' --ignore-pattern 'migrations/'",
    "type-check": "tsc --noEmit -p tsconfig.ci.json",
    "test": "jest",
    "test:ci": "jest --runInBand",
    "test:unit": "jest",
    "test:integration:hydration": "jest --testPathPatterns=HydrationAndDataIntegration --runInBand",
    "test:integration:live": "jest --testPathPatterns='(HydrationAndDataIntegration|AnalysesPage|AuthorsPage|seed)' --runInBand",
    "test:e2e": "cypress run --headless",
    "test:e2e:hydration": "cypress run --spec 'cypress/e2e/hydration.cy.ts'",
    "check:posts": "bash scripts/check-posts.sh",
    "check:cms-mdx-media": "bash scripts/ci/check-cms-mdx-media-paths.sh",
    "audit:policy": "bash scripts/ci/security-audit-policy.sh",
    "cms:import": "tsx scripts/cms/import-legacy-to-strapi.ts",
    "cms:verify": "tsx scripts/cms/verify-parity.ts",
    "strapi:dev": "npm --prefix strapi run develop",
    "strapi:build": "npm --prefix strapi run build",
    "strapi:start": "npm --prefix strapi run start",
    "db:seed": "echo 'Seeding handled by migrations - data included in InitialSetup migration'",
    "migration:run": "tsx node_modules/.bin/typeorm migration:run -d lib/db.datasource.ts",
    "migration:create": "tsx node_modules/.bin/typeorm migration:create",
    "migration:revert": "tsx node_modules/.bin/typeorm migration:revert -d lib/db.datasource.ts"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.0",
    "@mdx-js/react": "^3.1.0",
    "@next/mdx": "^15.5.0",
    "@popperjs/core": "^2.11.8",
    "bcrypt": "^6.0.0",
    "gray-matter": "^4.0.3",
    "mdx": "^0.3.1",
    "mysql2": "^3.15.3",
    "next": "^16.1.6",
    "next-auth": "4.24.12",
    "next-mdx-remote": "^5.0.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.4",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "typeorm": "^0.3.20",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@exodus/bytes": "^1.8.0",
    "@npmcli/fs": "^5.0.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "csv-parse": "^6.1.0",
    "cypress": "^15.8.2",
    "eslint": "^9.39.3",
    "eslint-config-next": "15.4.6",
    "eslint-plugin-boundaries": "^5.3.1",
    "jest": "^30.1.1",
    "jest-environment-jsdom": "^30.1.1",
    "lighthouse": "^13.0.3",
    "node-fetch": "^3.3.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.4",
    "typescript": "^5.6.0",
    "wait-on": "^9.0.4"
  },
  "overrides": {
    "axios": "^1.13.5",
    "diff": "^4.0.4",
    "lodash": "^4.17.23",
    "trim-newlines": "3.0.1",
    "nodemailer": "^7.0.7",
    "qs": ">=6.15.0",
    "rimraf": "^4.4.1",
    "glob": "^9.3.5",
    "@npmcli/move-file": "npm:@npmcli/fs@^5.0.0",
    "html-encoding-sniffer": "^6.0.0",
    "jsdom": "^27.4.0",
    "minimatch": "^10.2.1",
    "@eslint/eslintrc": {
      "minimatch": "3.1.2"
    },
    "test-exclude": {
      "minimatch": "3.1.2"
    }
  }
}
