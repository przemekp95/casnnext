{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": { "@/*": ["./*"] },
    "types": ["node", "jest"]
  },
  "include": [
    "scripts/ci/disposable-lifecycle/**/*.ts",
    "test/unit/ci/disposable-lifecycle/**/*.ts",
    "test/integration/ci/disposable-lifecycle.test.ts"
  ]
}
