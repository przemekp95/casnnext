# Environment Configuration for CASN Docker Setup

# Database Configuration
MYSQL_ROOT_PASSWORD=rootpassword123
MYSQL_DATABASE=casn
MYSQL_USER=casn_user
MYSQL_PASSWORD=casn_password123
DATABASE_URL=mysql://casn_user:casn_password123@mysql:3306/casn

# Next.js Configuration
NODE_ENV=production
NEXTAUTH_SECRET=your-secret-key-here-change-this-in-production
NEXTAUTH_URL=http://localhost:3000
CONTENT_PROVIDER=legacy

# Strapi Configuration
STRAPI_INTERNAL_URL=http://strapi:1337
NEXT_PUBLIC_STRAPI_URL=http://localhost/cms
STRAPI_API_TOKEN=
STRAPI_WEBHOOK_SECRET=change-me
REVALIDATE_SECRET=change-me
APP_KEYS=app-key-1,app-key-2,app-key-3,app-key-4
API_TOKEN_SALT=api-token-salt-change-me
ADMIN_JWT_SECRET=admin-jwt-secret-change-me
TRANSFER_TOKEN_SALT=transfer-token-salt-change-me
JWT_SECRET=jwt-secret-change-me

# Application URLs
APP_URL=http://localhost:3000

# Development vs Production
# For development, you can use:
# NODE_ENV=development
# NEXTAUTH_URL=http://localhost:3000
