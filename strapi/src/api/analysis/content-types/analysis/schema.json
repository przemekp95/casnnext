{
  "kind": "collectionType",
  "collectionName": "cms_analyses",
  "info": {
    "singularName": "analysis",
    "pluralName": "analyses",
    "displayName": "Analysis"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "legacyId": {
      "type": "integer",
      "unique": true
    },
    "sourceHash": {
      "type": "string"
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true,
      "unique": true
    },
    "title": {
      "type": "string",
      "required": true
    },
    "lead": {
      "type": "text"
    },
    "description": {
      "type": "text"
    },
    "date": {
      "type": "date"
    },
    "category": {
      "type": "string"
    },
    "contentMdx": {
      "type": "text",
      "required": true
    },
    "author": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::author.author",
      "inversedBy": "analyses"
    }
  }
}
