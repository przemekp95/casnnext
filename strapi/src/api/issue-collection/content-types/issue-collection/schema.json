{
  "kind": "collectionType",
  "collectionName": "cms_issue_collections",
  "info": {
    "singularName": "issue-collection",
    "pluralName": "issue-collections",
    "displayName": "Issue Collection"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "year": {
      "type": "integer",
      "required": true,
      "unique": true
    },
    "title": {
      "type": "string",
      "required": true
    },
    "file": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["files"]
    },
    "cover": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    }
  }
}
